{
  "name": "issue-watcher",
  "version": "0.2.2",
  "description": "Emails AI summaries of new issues in your starred GitHub repositories",
  "main": "build/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"build/__tests__/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "eval:export": "tsx src/eval/cli.ts export",
    "eval:report": "tsx src/eval/cli.ts report",
    "eval:rebuild": "tsx src/eval/cli.ts rebuild",
    "package:mcp": "tsx scripts/stage-mcp.ts",
    "build:mcpb": "tsx scripts/build-mcpb.ts",
    "verify:release": "tsx scripts/verify-release.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "ioredis": "^6.0.0",
    "nodemailer": "^7.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "eslint": "^9.39.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mac146/IssueWatcher.git"
  },
  "private": true
}
