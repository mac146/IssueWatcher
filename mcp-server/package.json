{
  "name": "issue-watcher",
  "version": "1.0.0",
  "description": "Emails AI summaries of new issues in your starred GitHub repositories",
  "main": "build/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"build/__tests__/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "eval:export": "tsx src/eval/cli.ts export",
    "eval:report": "tsx src/eval/cli.ts report",
    "eval:rebuild": "tsx src/eval/cli.ts rebuild"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "ioredis": "^6.0.0",
    "nodemailer": "^7.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mac146/IssueWatcher.git"
  },
  "private": true
}
