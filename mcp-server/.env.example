# Copy to .env and fill in. See README for details.

# Required
GITHUB_TOKEN=
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# AI summaries (all optional). Set one or more keys; providers with a key are used in this order
# and the next one takes over when one is rate-limited. With none, digests use plain excerpts.
# GOOGLE_API_KEY=            # Gemini (GEMINI_API_KEY also works)   model: GEMINI_MODEL
# OPENAI_API_KEY=            # OpenAI                               model: OPENAI_MODEL, endpoint: OPENAI_BASE_URL
# ANTHROPIC_API_KEY=         # Claude                               model: ANTHROPIC_MODEL
# GROQ_API_KEY=              # Groq                                 model: GROQ_MODEL
# OPENROUTER_API_KEY=        # OpenRouter                           model: OPENROUTER_MODEL
# CUSTOM_LLM_BASE_URL=       # any OpenAI-compatible server, e.g. Ollama: http://localhost:11434/v1
# CUSTOM_LLM_MODEL=          # required with CUSTOM_LLM_BASE_URL
# CUSTOM_LLM_API_KEY=        # optional (local servers need none)
# LLM_PROVIDERS=             # explicit order, e.g. groq,gemini; "none" disables AI
# EXTRACTIVE_FALLBACK=true   # use a plain excerpt when no AI summary is available
# REDIS_URL=                 # e.g. redis://localhost:6379 ; caches summaries across runs (memory if unset)
# CACHE_TTL_DAYS=30

# Optional (defaults shown)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# MAIL_FROM=
# WATCH_INTERVAL=1800000
# STATE_FILE=data/state.json
# MAX_ISSUES_PER_EMAIL=50
# MAX_BODY_CHARS=4000
# LLM_CONCURRENCY=3
# LLM_BATCH_SIZE=8         # issues summarised per LLM request
# LLM_RPM=5                # requests/minute per provider; 5 suits free tiers
# DEPENDENCY_SCAN=true            # also watch repos of libraries your own projects use
# DEPENDENCY_REPOS=               # owner/name list to scan; default: your recently pushed repos
# MAX_DEPENDENCY_REPOS=20
# MAX_DEPENDENCIES=100
# SCORING_MODE=both               # consumer (what could break my projects), contributor (what can I fix), or both
# MIN_SUMMARY_SCORE=30            # only issues scoring at least this get an AI summary
# IGNORE_REPOS=                   # comma-separated, * wildcard, e.g. 100xdevs-*/*
# IGNORE_LABELS=                  # e.g. question,duplicate
# DRY_RUN=false                   # print the ranked list; no LLM, email or state changes
# PREVIEW_PER_REPO=3
# RUN_ONCE=false
